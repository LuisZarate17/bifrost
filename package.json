{
  "name": "bifrost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "app:vidar": "npm run app -w apps/vidar",
    "dev:vidar": "npm run dev -w apps/vidar",
