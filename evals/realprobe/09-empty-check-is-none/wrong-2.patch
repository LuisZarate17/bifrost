+    /// An empty command is not kept at all: setting one clears the folder's check, and a hand-edited
+    /// `"C:\\x": []` is gone on load, so the next save does not write it back.
+    #[test]
+    fn an_empty_command_is_cleared_when_set_and_dropped_when_loaded() {
+        let mut c = Config::default();
+        c.set_check(r"C:\x", Some(vec!["cargo".into(), "check".into()]));
+        c.set_check(r"c:\X", Some(vec![]));
+        assert!(c.checks.is_empty());
+        let c: Config = serde_json::from_str(r#"{"checks":{"C:\\x":[],"C:\\y":["cargo","test"]}}"#).unwrap();
+        assert_eq!(c.checks.len(), 1);
+        assert!(c.check_for(r"C:\y").is_some());
+        assert!(!serde_json::to_string(&c).unwrap().contains(r"C:\\x"));
+    }
