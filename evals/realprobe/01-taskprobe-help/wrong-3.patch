+    #[test]
+    fn an_unknown_flag_is_found_and_a_value_is_not_taken_for_one() {
+        assert_eq!(unknown_flag(&words(&[])), None);
+        assert_eq!(unknown_flag(&words(&["--model", "x", "--runs", "1", "--keep", "--selfcheck", "-h"])), None);
+        assert_eq!(unknown_flag(&words(&["--model", "x", "--runs", "1", "--bogus", "--nope"])), Some("--bogus".into()));
+        assert_eq!(unknown_flag(&words(&["--only", "-x"])), None, "the word after a value flag is its value");
+        assert_eq!(unknown_flag(&words(&["--keep", "-x"])), Some("-x".into()), "--keep takes no value");
+        assert_eq!(unknown_flag(&words(&["--model=x"])), Some("--model=x".into()));
+        assert_eq!(unknown_flag(&words(&["b02"])), None, "only words that start with a dash are checked");
+    }
