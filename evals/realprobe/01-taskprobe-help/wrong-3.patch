+/// The flags that take the word after them as their value.
+const VALUE_FLAGS: [&str; 9] =
+    ["--model", "--runs", "--only", "--mode", "--compact", "--read", "--plan", "--ops", "--think"];
+
+/// The flags that stand alone.
+const PLAIN_FLAGS: [&str; 4] = ["--keep", "--selfcheck", "--help", "-h"];
+
+const USAGE: &str = "\
+usage: taskprobe [flags]
+
+  --model <tag>      the model to run (default: the config's)
+  --runs <n>         runs per task at the app's own settings (default 3)
+  --only <prefix>    only the tasks whose id starts with this
+  --mode <how>       interactive (default), propose or both
+  --compact <on|off> compact the conversation as the app does (default on)
+  --read <how>       parts (default) or whole
+  --plan <on|off>    offer the task list tool (default on)
+  --keep             keep the scratch folders
+  --selfcheck        run no model: check that every task scores as it should
+  --help, -h         show this help
+";
+
+/// The first argument that starts with `-` and is not a flag taskprobe knows, if any. The word
+/// right after a flag that takes a value is that value, whatever it starts with.
+fn unknown_flag(args: &[String]) -> Option<String> {
+    let mut i = 0;
+    while i < args.len() {
+        let a = args[i].as_str();
+        if VALUE_FLAGS.contains(&a) {
+            i += 2;
+        } else if a.starts_with('-') && !PLAIN_FLAGS.contains(&a) {
+            return Some(a.to_string());
+        } else {
+            i += 1;
+        }
+    }
+    None
+}
+
 fn main() {
     let args: Vec<String> = std::env::args().skip(1).collect();
+    if let Some(bad) = unknown_flag(&args) {
+        eprintln!("unknown flag: {bad}\n\n{USAGE}");
+        std::process::exit(2);
+    }
+    if args.iter().any(|a| a == "--help" || a == "-h") {
+        print!("{USAGE}");
+        std::process::exit(0);
+    }
     let cfg = config::load();
     let model = arg(&args, "--model").unwrap_or(cfg.model.clone());
     let runs: usize = arg(&args, "--runs").and_then(|s| s.parse().ok()).unwrap_or(3);
