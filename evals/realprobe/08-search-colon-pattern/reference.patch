+/// Whether a pattern starts at a drive: `C:` at its start (`C:/x`, `C:x`), or as a whole
+/// alternative inside braces (`{C:/,x}/**`). A colon anywhere else is not a drive.
+fn names_drive(p: &str) -> bool {
+    let lead = |s: &str| matches!(s.as_bytes(), [letter, b':', ..] if letter.is_ascii_alphabetic());
+    lead(p)
+        || p.match_indices(['{', ',']).any(|(at, _)| {
+            let rest = &p[at + 1..];
+            lead(rest) && matches!(rest.as_bytes().get(2), None | Some(b'/' | b',' | b'}'))
+        })
+}
