+++ b/apps/hugin/src/print.rs
@@ -128,10 +128,14 @@ pub struct Args {
     pub trace: Option<PathBuf>,
 }
 
+/// The Node tools that are batch files on Windows, which a program is not started from by name alone.
+const SHIMS: [&str; 4] = ["npm", "npx", "pnpm", "yarn"];
+
 /// `--check`'s text as the program and arguments it runs. **It is run directly, not by a
 /// shell**, so quotes group words and nothing else is special — which is why a pipe, `&&`, a
 /// redirect or a variable is refused rather than passed on as an argument that would mean
-/// nothing. `npm` is spelled `npm.cmd`, which is what Windows runs.
+/// nothing. `npm`, `npx`, `pnpm` and `yarn` (in any case) are spelled `npm.cmd`, `npx.cmd`,
+/// `pnpm.cmd` and `yarn.cmd`, which is what Windows runs.
 pub fn parse_check(text: &str) -> Result<Vec<String>, String> {
     let mut words: Vec<String> = Vec::new();
     let (mut word, mut started, mut quote) = (String::new(), false, None::<char>);
@@ -169,8 +173,8 @@ pub fn parse_check(text: &str) -> Result<Vec<String>, String> {
     if words.is_empty() {
         return Err("--check needs a command".to_string());
     }
-    if words[0].eq_ignore_ascii_case("npm") {
-        words[0] = "npm.cmd".to_string();
+    if let Some(shim) = SHIMS.iter().find(|name| words[0].eq_ignore_ascii_case(name)) {
+        words[0] = format!("{shim}.cmd");
     }
     Ok(words)
 }
diff --git a/apps/hugin/src/print_tests.rs b/apps/hugin/src/print_tests.rs
